      "boundElements": null,
      "updated": 1786377722936,
      "link": null,
      "locked": false,
      "text": "This allows us to do steps in exact order - like building a pizza, we need cheese first\nbefore any toppings but after that we can add sausages, onions, capsicum, corn, and\nmany others or none of them in any particular order we want ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This allows us to do steps in exact order - like building a pizza, we need cheese first before any toppings but after that we can add sausages, onions, capsicum, corn, and many others or none of them in any particular order we want ",
      "autoResize": false,
      "lineHeight": 1.25
    },
