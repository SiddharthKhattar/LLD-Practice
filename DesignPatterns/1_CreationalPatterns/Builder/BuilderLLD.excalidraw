      "seed": 1900137418,
      "version": 589,
      "versionNonce": 184953226,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786369008809,
      "link": null,
      "locked": false,
      "text": "// server code\n\nclass HTTPReq{\n    String url;\n    String method;\n    map<String, String> headers;\n    ........\n    HTTPReq(URL, method, head6ers,.......){\n        this->url = url;\n        this->method = method;\n           ........\n}\n\nvoid execute(url, method, headers){\n        // HTTP Call is done from here\n}\n\n}\n\n// we will need to create a lot of constructors\nhere to adjust for diff combinations of\nconstructors",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// server code\n\nclass HTTPReq{\n    String url;\n    String method;\n    map<String, String> headers;\n    ........\n    HTTPReq(URL, method, head6ers,.......){\n        this->url = url;\n        this->method = method;\n           ........\n}\n\nvoid execute(url, method, headers){\n        // HTTP Call is done from here\n}\n\n}\n\n// we will need to create a lot of constructors here to adjust for diff combinations of constructors",
      "autoResize": false,
      "lineHeight": 1.25
    },
