    },
    {
      "id": "ORB3itlYQe2Ni_c65YgcE",
      "type": "text",
      "x": 223.16601474068102,
      "y": 838.8960756398752,
      "width": 551.5427421939567,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bWL",
      "roundness": null,
      "seed": 100454154,
      "version": 698,
      "versionNonce": 940623946,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786369731328,
      "link": null,
      "locked": false,
      "text": "Problems with normal object creation:\n\n1) Constructor Telescoping (Constructor Overloading)\n2) Generally, a class becomes mutable when we allot a\nlot of getter, setters for all variables which may not be\nwhat we want\n3) Inconsistent State Problem\n4) Scattered Validation\n\n-> All of these problems complement and contradict each\nother, some may occur at once together while others\nonly one at a time when we are creating objects\nWITHOUT using builder design pattern ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problems with normal object creation:\n\n1) Constructor Telescoping (Constructor Overloading)\n2) Generally, a class becomes mutable when we allot a lot of getter, setters for all variables which may not be what we want\n3) Inconsistent State Problem\n4) Scattered Validation\n\n-> All of these problems complement and contradict each other, some may occur at once together while others only one at a time when we are creating objects WITHOUT using builder design pattern ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "HSN5R3pcH1J9s5WYlgXzp",
      "type": "text",
      "x": 273.89460734831704,
      "y": 611.543835408572,
      "width": 473.3320887407803,
      "height": 152.38284811340478,
      "angle": 0,
      "strokeColor": "#e64980",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bWM",
      "roundness": null,
      "seed": 1975671114,
      "version": 432,
      "versionNonce": 1045443158,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786369512384,
      "link": null,
      "locked": false,
      "text": "runtime errors are much worse\nthan compile time errors as the\ndeveloper konws beforehand\nthat there is a problem",
      "fontSize": 30.476569622680945,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "runtime errors are much worse than compile time errors as the developer konws beforehand that there is a problem",
      "autoResize": false,
      "lineHeight": 1.25
    },
