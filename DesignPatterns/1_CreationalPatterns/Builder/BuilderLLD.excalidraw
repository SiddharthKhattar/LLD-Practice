      "seed": 628611018,
      "version": 366,
      "versionNonce": 471055894,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786368762933,
      "link": null,
      "locked": false,
      "text": "HTTP Request\n\n(things that we send in a HTTP call)\n\n-> URL (www.example.com/target)\n-> method (GET, POST, PUT, DELETE,...) \n-> headers (Content-type: application/json......)\n-> QueryParameters (optional)\n-> Body\n-> timeout (default: 60 secs)\n\nwhenever execute() is called, a req should go from client to server",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTP Request\n\n(things that we send in a HTTP call)\n\n-> URL (www.example.com/target)\n-> method (GET, POST, PUT, DELETE,...) \n-> headers (Content-type: application/json......)\n-> QueryParameters (optional)\n-> Body\n-> timeout (default: 60 secs)\n\nwhenever execute() is called, a req should go from client to server",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "s2biRQQbt2duHsRTG5YGT",
      "type": "text",
      "x": 986.0910297740586,
      "y": 470.4090756503017,
      "width": 470.02473449707026,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
