    {
      "id": "W4DvXFimo7c8CgESl1gbc",
      "type": "text",
      "x": 1101.5454503839665,
      "y": 80.86364711414683,
      "width": 645.3395385742188,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
