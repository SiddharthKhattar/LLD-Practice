      "link": null,
      "locked": false,
      "text": "Bridge decouples an abstraction from its\nimplementations, so that both can vary independently",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bridge decouples an abstraction from its implementations, so that both can vary independently",
      "autoResize": false,
      "lineHeight": 1.25
    },
