    {
      "id": "h9axmVue7wrPnUeY63vsK",
      "type": "text",
      "x": 492.78791739330677,
      "y": 336.5605662972432,
      "width": 664.219482421875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
