      "link": null,
      "locked": false,
      "text": "display(){\n    if(idx == nullptr){\n        idis = new ImageDisplay();\n        idis->display();\n        // NOW only when calling the\nfunction will the expensive\noperation will happen\n    }",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "display(){\n    if(idx == nullptr){\n        idis = new ImageDisplay();\n        idis->display();\n        // NOW only when calling the function will the expensive operation will happen\n    }",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "z-F1CQOv1ON0wWvoirm0d",
      "type": "text",
      "x": 702.9397935817234,
      "y": 1398.2260309282092,
      "width": 544.6604537720585,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bPF",
      "roundness": null,
      "seed": 366487267,
      "version": 709,
      "versionNonce": 1158963587,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785561101632,
      "link": null,
      "locked": false,
      "text": "Protects any expensive resource through a proxy, by\nmaking sure that it is not being done until the function\nis directly called by the client, this will make the\ndisplay() method being called a little slower than usual\nbut this results in much less wastage of resources.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Protects any expensive resource through a proxy, by making sure that it is not being done until the function is directly called by the client, this will make the display() method being called a little slower than usual but this results in much less wastage of resources.",
      "autoResize": false,
      "lineHeight": 1.25
    },
