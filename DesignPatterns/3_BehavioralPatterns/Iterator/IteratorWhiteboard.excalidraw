      ],
      "updated": 1785819215503,
      "link": null,
      "locked": false,
      "text": "for(song: songs){\n    song->path\n    // then plays the song;\n}\n\n// the method needs to know how the songs are stored (like in a linkedlist,\nvector or some other data structure) so the iterator needs to know the data\nstructure, this will cause problems - SingleResponsibility principle is being\nbroken here cause logic of storing and traversing are in the same place + both\nneed to be aware of each other \n\nBelow diagram should be the ideal scenario instead where both logic are  in\ndifferent classes altogether\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for(song: songs){\n    song->path\n    // then plays the song;\n}\n\n// the method needs to know how the songs are stored (like in a linkedlist, vector or some other data structure) so the iterator needs to know the data structure, this will cause problems - SingleResponsibility principle is being broken here cause logic of storing and traversing are in the same place + both need to be aware of each other \n\nBelow diagram should be the ideal scenario instead where both logic are  in different classes altogether\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
