      "link": null,
      "locked": false,
      "text": "For n objects, we will need n-1 interaction.\nThis is a problem because this is getting tightly coupled, which we want to avoid.\nMediator design pattern helps us avoid this.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For n objects, we will need n-1 interaction.\nThis is a problem because this is getting tightly coupled, which we want to avoid.\nMediator design pattern helps us avoid this.",
      "autoResize": true,
      "lineHeight": 1.25
    },
