        }
      ],
      "updated": 1785771472140,
      "link": null,
      "locked": false,
      "text": "The problem with this way is that whenever we\nmake more objects of this class (u1, u2, u3....)\nour list will keep increasing then as each object\nwill have its own vector<User> string of all\nother users that it can send and recieve\nmessages to/from.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The problem with this way is that whenever we make more objects of this class (u1, u2, u3....) our list will keep increasing then as each object will have its own vector<User> string of all other users that it can send and recieve messages to/from.",
      "autoResize": false,
      "lineHeight": 1.25
    },
