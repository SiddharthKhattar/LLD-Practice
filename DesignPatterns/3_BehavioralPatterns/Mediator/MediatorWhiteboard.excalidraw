    {
      "id": "H4bNFgUoXotp2x2QV6Fj5",
      "type": "text",
      "x": -102.37124675233525,
      "y": 458.95624478231923,
      "width": 532.398245675223,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOc",
      "roundness": null,
      "seed": 810907917,
      "version": 1243,
      "versionNonce": 285429460,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785763134405,
      "link": null,
      "locked": false,
      "text": "When a user sends a req, \nit will send it to proxy, \nthen proxy will validate the request using some logic, \nand then it will send the request to the resource.\n\nResource will give some output to the proxy and then\nproxy will give output to the user.\n\nThere may be many reasons why we use a proxy, one\nof them being that the resource may be present on\nanother server than the user so it cant be accessed\ndirectly. To the end user, it cant differentiate\nsending between the proxy and the actual resource.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When a user sends a req, \nit will send it to proxy, \nthen proxy will validate the request using some logic, \nand then it will send the request to the resource.\n\nResource will give some output to the proxy and then proxy will give output to the user.\n\nThere may be many reasons why we use a proxy, one of them being that the resource may be present on another server than the user so it cant be accessed directly. To the end user, it cant differentiate sending between the proxy and the actual resource.\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "O9u6XwyDBGxhH2YJlkbbn",
      "type": "text",
      "x": 631.122048547644,
      "y": 626.4452371602758,
      "width": 226.95986938476562,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOh",
      "roundness": null,
      "seed": 1768148931,
      "version": 659,
      "versionNonce": 1857861740,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785763134405,
      "link": null,
      "locked": false,
      "text": "Three types of proxy -\n\n1) Virtual Proxy -> \n2) Protection\n3) Remote",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Three types of proxy -\n\n1) Virtual Proxy -> \n2) Protection\n3) Remote",
      "autoResize": true,
      "lineHeight": 1.25
    },
