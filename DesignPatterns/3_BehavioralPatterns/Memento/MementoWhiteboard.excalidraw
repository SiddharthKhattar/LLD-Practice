    {
      "id": "Xtb9aQldxJ3HzCj2K3Fr-",
      "type": "text",
      "x": -50.64395173390676,
      "y": 886.287848154704,
      "width": 1036.8500061035154,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bSw",
      "roundness": null,
      "seed": 1295502854,
      "version": 494,
      "versionNonce": 801029318,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785849439766,
      "link": null,
      "locked": false,
      "text": "Whenever we change or update the values in a database but they are incompatible/ goes to an\ninconsistent state for any reason, then we need to rollback to the previous state. for this we need a\nsnapshot. this is also a part of the ACID properties\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Whenever we change or update the values in a database but they are incompatible/ goes to an inconsistent state for any reason, then we need to rollback to the previous state. for this we need a snapshot. this is also a part of the ACID properties\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
