      "updated": 1785924976043,
      "link": null,
      "locked": false,
      "text": "Design Patterns that we will implement in this project\n-> Strategy\n-> Singleton\n-> Adapter\n-> Factory\n-> Facade",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Design Patterns that we will implement in this project\n-> Strategy\n-> Singleton\n-> Adapter\n-> Factory\n-> Facade",
      "autoResize": true,
      "lineHeight": 1.25
    },
