    {
      "id": "zoubm8AUGkKtNurooSuNQ",
      "type": "text",
      "x": 304.3634033203125,
      "y": 34.318216497247874,
      "width": 628.1445922851562,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTR",
      "roundness": null,
      "seed": 442526854,
      "version": 734,
      "versionNonce": 1758033626,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785923375027,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n\n-> User can play/pause songs\n-> User can create playlist, add songs to playlist, play entire\nplaylist (sequentialManner, Random manner, custom, etc)\n-> App should support multiple output devices (Bluetooth\nspeaker, wired speaker, headphones, etc)\n\nNon-Functional Requirements:\n\n-> Entire Design should be easily scalable\n-> New features (new output device, new way to play songs in\nplaylist, etc) can be easily created",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements:\n\n-> User can play/pause songs\n-> User can create playlist, add songs to playlist, play entire playlist (sequentialManner, Random manner, custom, etc)\n-> App should support multiple output devices (Bluetooth speaker, wired speaker, headphones, etc)\n\nNon-Functional Requirements:\n\n-> Entire Design should be easily scalable\n-> New features (new output device, new way to play songs in playlist, etc) can be easily created",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "YenwOoOOe1QElwLaHzLma",
      "type": "text",
      "x": 311.63627115885413,
      "y": 417.924178614761,
      "width": 524.0396118164062,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
