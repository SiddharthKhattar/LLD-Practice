    {
      "id": "xcDmkSB2IHtnxTKVOr056",
      "type": "text",
      "x": -162.19696426391602,
      "y": 114.65904871622723,
      "width": 670.0571746826172,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bSj",
      "roundness": null,
      "seed": 1766186458,
      "version": 898,
      "versionNonce": 796353862,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1785923205847,
      "link": null,
      "locked": false,
      "text": "We want to be able to rollback to a previous state by rolling back\nthrough a snapshot, so whenever the state of our object changes\nwe will take a snapshot so that we can roll back to it\n\n1) Memento - screenshot that we take of object after every change\n2) Originator - The object which state changes\n3) Caretaker - stores and manages all the mementos\n\nDefinition: Provides an ability to take snapshot of an object at\nvarious points in time and provide undo capabilites to a previous\nstate.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We want to be able to rollback to a previous state by rolling back through a snapshot, so whenever the state of our object changes we will take a snapshot so that we can roll back to it\n\n1) Memento - screenshot that we take of object after every change\n2) Originator - The object which state changes\n3) Caretaker - stores and manages all the mementos\n\nDefinition: Provides an ability to take snapshot of an object at various points in time and provide undo capabilites to a previous state.",
      "autoResize": false,
      "lineHeight": 1.25
    },
