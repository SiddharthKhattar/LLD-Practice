    {
      "id": "YP3plczwWVgwiGGMTXeME",
      "type": "text",
      "x": 1024.393062343318,
      "y": 0.1613726653877734,
      "width": 591.7333934660284,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEj",
      "roundness": null,
      "seed": 484313657,
      "version": 1075,
      "versionNonce": 973887863,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785189045725,
      "link": null,
      "locked": false,
      "text": "Requirements:\n\n    -> User can swipe left / right to a profile\n    -> User can setup his/her own profile\n    -> User can set his/her preferences\n    -> Once there is a match they can chat in chatroom.\n    -> User can see all the profiles near their location\n(Nearby can be based on different strategy)\n    -> User should get notified when there is a match, or\nrecieve a new message\n    -> User Matching should be based on several factor &\nscores (like interest match, location match, etc) ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requirements:\n\n    -> User can swipe left / right to a profile\n    -> User can setup his/her own profile\n    -> User can set his/her preferences\n    -> Once there is a match they can chat in chatroom.\n    -> User can see all the profiles near their location (Nearby can be based on different strategy)\n    -> User should get notified when there is a match, or recieve a new message\n    -> User Matching should be based on several factor & scores (like interest match, location match, etc) ",
      "autoResize": false,
      "lineHeight": 1.25
    },
